# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=grounded-visual-inspector
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 실행 백엔드. 실행 스크립트가 모드별 기본값을 정하며, 직접 실행할 때만 주석을 푼다.
# LLM_BACKEND=openai
# VLM_BACKEND=openai
# EMBED_BACKEND=openai
# HITL_MODE=interactive
# VLM_OBSERVER_MODEL=gpt-4o-mini
# VLM_CROSS_MODEL=gpt-4o

# Ollama 로컬 실측 기본값. bge-m3는 R6 RAG 2종 비교용이며
# 운영 SpecIndex의 기본 임베딩은 nomic-embed-text를 유지한다.
# OLLAMA_FAST_MODEL=qwen3:0.6b
# OLLAMA_JUDGE_MODEL=qwen3:8b
# OLLAMA_QUALITY_MODEL=qwen3:8b
# VLM_OBSERVER_MODEL=qwen2.5vl:3b
# VLM_CROSS_MODEL=qwen2.5vl:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_RAG_COMPARE_EMBED_MODEL=bge-m3
# OLLAMA_FAST_NUM_PREDICT=512
# OLLAMA_JUDGE_NUM_PREDICT=512
# OLLAMA_QUALITY_NUM_PREDICT=2048
# OLLAMA_LLM_WALL_TIMEOUT_S=300

# LLM_BACKEND=openai 모드(run_agent_openai.sh)에서만 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
